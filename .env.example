# PostgreSQL
POSTGRES_USER=brein
POSTGRES_PASSWORD=brein_dev
POSTGRES_DB=digitaal_brein
DATABASE_URL=postgresql+asyncpg://brein:brein_dev@db:5432/digitaal_brein

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=digitaal-brein

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=debug

# Embeddings (deferred to Phase 2)
EMBEDDING_MODEL=microsoft/harrier-oss-v1-0.6b
EMBEDDING_DIMENSION=1024

# Query Planner LLM (Phase 4)
# PLANNER_LLM_PROVIDER=ollama
# PLANNER_LLM_MODEL=qwen2.5:7b
# PLANNER_LLM_URL=http://localhost:11434

# Summarization LLM (Phase 7)
# SUMMARY_LLM_PROVIDER=ollama
# SUMMARY_LLM_MODEL=qwen2.5:14b

# API Security
API_KEYS=sk-company:agent_company_knowledge,sk-sales:agent_sales_prospector,sk-analyst:agent_analyst
REQUIRE_API_KEY=false

# MCP Server (remote mode)
MCP_HOST=0.0.0.0
MCP_PORT=8001
BREIN_API_KEY=

# Chatbot LLM keys (used by `pnpm dev` local workflow)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
