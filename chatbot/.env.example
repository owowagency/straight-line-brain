# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxx

# Optional: Anthropic API key — https://console.anthropic.com
# Needed only if you want to use Claude models in the model selector.
ANTHROPIC_API_KEY=sk-ant-xxx

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# Digitaal Brein MCP Server
# In Docker: http://mcp:8001/mcp
# Local dev: http://localhost:8001/mcp
MCP_SERVER_URL=http://localhost:8001/mcp
